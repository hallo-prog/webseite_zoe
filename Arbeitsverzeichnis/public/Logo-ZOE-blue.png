<svg width="200" height="80" viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg">
  <style>
    .zoe {
      font-family: 'Inter', sans-serif;
      font-size: 40px;
      font-weight: 800;
      fill: #2563eb; /* blue-600 */
    }
    .solar {
      font-family: 'Inter', sans-serif;
      font-size: 40px;
      font-weight: 400;
      fill: #1a1a1a;
    }
    .sun-ray {
      stroke: #1a1a1a;
      stroke-width: 3;
      stroke-linecap: round;
    }
  </style>

  <text x="5" y="35" class="zoe">zoe</text>
  <text x="5" y="70" class="solar">Solar</text>

  <g transform="translate(140, 35)">
    <path d="M0,0 A20,20 0 0,1 20,-20" fill="none" stroke="#1a1a1a" stroke-width="3"/>
    <line x1="22" y1="-22" x2="25" y2="-25" class="sun-ray" />
    <line x1="15" y1="-25" x2="18" y2="-28" class="sun-ray" />
    <line x1="5" y1="-28" x2="8" y2="-31" class="sun-ray" />
    <line x1="-5" y1="-28" x2="-8" y2="-31" class="sun-ray" />
    <line x1="-15" y1="-25" x2="-18" y2="-28" class="sun-ray" />
  </g>
</svg>
